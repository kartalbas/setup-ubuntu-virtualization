# Managed by setup-ubuntu-virtualization: RD Gateway behind Caddy.
[Unit]
Description=RD Gateway (rdpgw): RDP over HTTPS to the VMs
RequiresMountsFor=@DATA_DIR@
Requires=rdpgw-auth.service
After=network-online.target rdpgw-auth.service
Wants=network-online.target

[Service]
DynamicUser=yes
User=rdpgw
Group=rdpgw
LoadCredential=rdpgw.yaml:@GATEWAY_CONF_DIR@/rdpgw.yaml
WorkingDirectory=/tmp
ExecStart=@STACK_CURRENT@/bin/rdpgw -c ${CREDENTIALS_DIRECTORY}/rdpgw.yaml
# rdpgw listens on all interfaces; only Caddy (localhost) may talk to it, and
# it may only reach the VMs it lets through (this host's and REMOTE_VMS).
IPAddressDeny=any
IPAddressAllow=@GATEWAY_ALLOW@
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
