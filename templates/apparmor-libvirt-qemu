# Managed by setup-ubuntu-virtualization: every guest's QEMU runs from the
# stack on the data disk and may render on the host GPU (virtio-gpu 3D).
  @DATA_DIR@/stack/*/bin/qemu-system-x86_64 rmix,
  @DATA_DIR@/stack/*/lib/** rm,
  @DATA_DIR@/stack/*/share/qemu/** rk,
  @DATA_DIR@/stack/*/libexec/virgl_render_server rix,
  /dev/dri/ r,
  /dev/dri/by-path/ r,
  /dev/dri/renderD[0-9]* rw,
  /dev/udmabuf rw,
  /usr/share/libdrm/amdgpu.ids r,
  /sys/devices/** r,
  /sys/bus/pci/devices/ r,
  /usr/share/drirc.d/ r,
  /usr/share/drirc.d/* r,
  /usr/share/vulkan/icd.d/ r,
  /usr/share/vulkan/icd.d/* r,
  /usr/share/glvnd/egl_vendor.d/ r,
  /usr/share/glvnd/egl_vendor.d/* r,
  /usr/share/egl/egl_external_platform.d/ r,
  /usr/share/egl/egl_external_platform.d/* r,
